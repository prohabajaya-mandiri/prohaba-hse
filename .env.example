# Runtime only. Never put migration or management credentials here.
DATABASE_URL="postgresql://hse_runtime_dev.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?schema=hse_dev&sslmode=require"
AUTH_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
AUTH_URL="http://localhost:3000"
# 32 byte base64. Wajib sama di semua instance; tanpa kunci ini data terenkripsi tidak dapat dibaca.
DATA_ENCRYPTION_KEY="BASE64_32_BYTES"
# local (development) | s3 (Supabase Storage, protokol S3)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_BUCKET="hse-private"
S3_ACCESS_KEY_ID="STORAGE_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="STORAGE_SECRET"
# Dipakai Vercel Cron untuk /api/cron/reminders
CRON_SECRET="RANDOM_SECRET"
APP_TIMEZONE="Asia/Jakarta"
